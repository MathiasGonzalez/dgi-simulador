<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Esquemas\*.xsd" LogicalName="Esquemas/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Wsdl\*.wsdl" LogicalName="Wsdl/%(Filename)%(Extension)" />
    <Content Remove="Homologacion\set-pruebas.json" />
    <EmbeddedResource Include="Homologacion\set-pruebas.json" LogicalName="Homologacion/set-pruebas.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DgiSimulador.Tests" />
  </ItemGroup>

</Project>
